# TelePixels Backend — STANDARD BUILD (real Postgres, no mocks)
# Copy to .env:  Copy-Item .env.example .env

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Auth (short access passes + rotating refresh tokens) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Database (Neon free tier — works locally AND for anyone testing anywhere) ---
# Neon dashboard → your project → Connection string (pooled). Keep ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/telepixels_db?sslmode=require

# --- Seed (first superadmin; change password right after first login) ---
SEED_SUPERADMIN_EMAIL=admin@kingsimaging.org
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

# --- AI (optional: without a key, /ai/draft + /ai/polish answer 503; data routes still work) ---
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Storage (local disk fallback; S3 API when STORAGE_DRIVER=s3) ---
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Backblaze B2 / R2 / Neon buckets (S3 API, path-style). Only keys are stored
# in Postgres; reads return fresh presigned URLs so links never go stale.
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_BUCKET=telepixel
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=eu-central-003
